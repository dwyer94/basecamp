{
  "id": "v-rising",
  "name": "V Rising",
  "kind": "steam",
  "steam_app_id": 1829350,
  "exe": "VRisingServer.exe",
  "args": "-persistentDataPath \".\\save-data\" -serverName \"V Rising\" -saveName \"world1\" -logFile \".\\logs\\VRisingServer.log\"",
  "ports": [
    {"port": 9876, "protocol": "udp", "label": "game"},
    {"port": 9877, "protocol": "udp", "label": "query"},
    {"port": 25575, "protocol": "tcp", "label": "rcon"}
  ],
  "join_port_label": "game",
  "log_source": "file",
  "log_file": "logs\\VRisingServer.log",
  "ready_pattern": "",
  "ready_after_s": 90,
  "stop_recipe": [
    {"action": "ctrl_break", "wait_s": 60}
  ],
  "stop_warning": {"action": "rcon", "command": "announce Server restarting in {minutes} min", "minutes": []},
  "config_files": [
    "save-data\\Settings\\ServerHostSettings.json",
    "save-data\\Settings\\ServerGameSettings.json"
  ],
  "save_dir": "save-data\\Saves",
  "rcon_port": 25575,
  "notes": "With -persistentDataPath, the server reads its settings from save-data\\Settings\\ and saves to save-data\\Saves\\v4\\<saveName>\\. Copy ServerHostSettings.json and ServerGameSettings.json there from VRisingServer_Data\\StreamingAssets\\Settings\\ (those are defaults, overwritten by updates). Command-line options win over the files. RCON is off until Rcon.Enabled and a password are set in ServerHostSettings.json. Its shutdown command is 'shutdown <message times> <message>'.",
  "docs": [
    "https://github.com/StunlockStudios/vrising-dedicated-server-instructions/blob/master/1.1.x-pc/INSTRUCTIONS.md",
    "https://steamdb.info/app/1829350/"
  ],
  "unverified": ["ready_pattern", "stop_recipe", "ports", "stop_warning"]
}
